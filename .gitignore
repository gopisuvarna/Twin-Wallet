# ==========================================
# TwinWallet - Complete Git Ignore Policy
# ==========================================

# 1. Environment & Secret Keys (DO NOT COMMIT TO GITHUB)
.env
.env.*
*.env
!.env.example
!*.env.example
backend/.env

# 2. Python & Backend Caches
__pycache__/
/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/

# 3. Database Files (SQLite Local Files)
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/twinwallet.db

# 4. Node.js & React Native / Expo Frontend
node_modules/
/**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
/**/.expo/
dist/
web-build/
*.apk
*.aab
*.ipa

# 5. Archive Files & System Junk
*.zip
*.tar.gz
*.rar
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
